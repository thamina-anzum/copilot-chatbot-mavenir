# Copy this file to the repo root as `.env` and fill in real values.
# Never commit a filled `.env`.

# --- MongoDB Atlas (conversation persistence) ---
# Use an SRV URI from Atlas ? Connect ? Drivers. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=rag-project

# --- LLM ---
# Primary: Google AI Studio. Fallback: Groq (skipped if the key is empty or REPLACE_ME).
GOOGLE_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=gemini

# --- Langfuse (optional; leave empty to disable tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Qdrant ---
# embedded = local folder (default). server = Docker Compose Qdrant.
QDRANT_MODE=embedded
QDRANT_PATH=data/qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=3gpp_chunks

# --- Retrieval / evidence gate ---
# Calibrate after ingest: python backend/scripts/calibrate_evidence_gate.py
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
VECTOR_TOP_K=10
BM25_TOP_K=10
HYBRID_CANDIDATES=20
RERANK_TOP_K=5
RRF_K=60
EVIDENCE_THRESHOLD=0.42
EVIDENCE_SECONDARY_THRESHOLD=0.28
EVIDENCE_MIN_CHUNKS=1

# --- Chunking ---
CHUNK_SIZE=1400
CHUNK_OVERLAP=180

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
